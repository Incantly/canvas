{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "allowJs": true
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "astro.config.*"
  ],
  "exclude": ["dist", "node_modules"],
  "references": [
    { "path": "../../packages/core" }
  ]
}
