---
import Base from '../../layouts/Base.astro'

const posts = Object.values(
  import.meta.glob('./*.md', { eager: true })
).sort((a, b) => new Date(b.frontmatter.date) - new Date(a.frontmatter.date))

const minutes = (p) => {
  try { return Math.max(2, Math.round(p.rawContent().split(/\s+/).length / 220)) }
  catch { return null }
}
const fmtDate = (d) =>
  new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
---
<Base
  title="Blog — Incantly Canvas"
  description="Guides and comparisons from the Incantly Canvas project: whiteboard SDKs, infinite canvases, real-time sync, and building drawing tools for the web and React Native."
>
  <main class="blog-index">
    <header>
      <h1>Blog</h1>
      <p class="lede">Guides, comparisons, and engine notes from an open-source whiteboard SDK.</p>
    </header>
    <div class="grid">
      {posts.map((p, i) => (
        <a class={`card${i === 0 ? ' featured' : ''}`} href={p.url + '/'}>
          <p class="meta">
            <time datetime={p.frontmatter.date}>{fmtDate(p.frontmatter.date)}</time>
            {minutes(p) && <span> · {minutes(p)} min read</span>}
          </p>
          <h2>{p.frontmatter.title}</h2>
          <p class="desc">{p.frontmatter.description}</p>
          <span class="read">Read the post →</span>
        </a>
      ))}
    </div>
  </main>
</Base>

<style>
  .blog-index { max-width: var(--max); margin: 0 auto; padding: 48px 20px 0; }
  h1 { font-size: clamp(32px, 4.6vw, 44px); margin: 0 0 8px; letter-spacing: -0.015em; }
  .lede { color: var(--ink-soft); margin: 0 0 36px; font-size: 17px; }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 18px; }
  .card {
    display: flex; flex-direction: column; gap: 8px;
    background: #fff; border: 1px solid var(--line); border-radius: var(--radius);
    padding: 24px 26px; color: inherit;
    transition: border-color 140ms ease, box-shadow 140ms ease, transform 140ms ease;
  }
  .card:hover {
    text-decoration: none; border-color: var(--accent);
    box-shadow: 0 10px 30px -18px rgba(28, 27, 24, 0.3);
    transform: translateY(-2px);
  }
  .card.featured { grid-column: 1 / -1; padding: 30px 32px; }
  .card.featured h2 { font-size: clamp(22px, 3vw, 28px); }
  .meta { font-size: 13px; color: var(--ink-soft); margin: 0; }
  .card h2 { font-size: 19px; line-height: 1.3; margin: 0; color: var(--ink); letter-spacing: -0.01em; }
  .desc { margin: 0; color: var(--ink-soft); font-size: 15px; flex: 1 1 auto; }
  .read { font-size: 14px; font-weight: 600; color: var(--accent-ink); }
</style>
