{
  "name": "incantly-native-rn-demo",
  "private": true,
  "version": "0.1.0",
  "description": "Standalone Expo demo for the native React Native renderer (roadmap 17). Not part of npm workspaces — own node_modules to avoid Metro/React conflicts.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.0",
    "babel-preset-expo": "~57.0.0",
    "@incantly/canvas-react-native": "file:../../packages/react-native",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.0",
    "expo-asset": "~57.0.0",
    "expo-constants": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-linking": "~57.0.0",
    "expo-router": "~57.0.0",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-enriched-markdown": "1.0.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.2.2",
    "babel-plugin-module-resolver": "^5.0.2",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "@incantly/canvas": "file:../../packages/core"
  }
}
