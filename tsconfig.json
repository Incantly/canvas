{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["es2022", "dom"],
    "types": [],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "references": [
    { "path": "packages/core" },
    { "path": "packages/react" },
    { "path": "packages/react-native" },
    { "path": "apps/app" },
    { "path": "apps/docs" },
    { "path": "apps/website" }
  ],
  "files": []
}
