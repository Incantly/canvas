{
  "name": "@incantly/canvas-react-native",
  "version": "0.2.0",
  "description": "React Native component for Incantly Canvas — native document renderer (Markdown + Skia).",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "default": "./dist/storage/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "sideEffects": false,
  "keywords": [
    "react-native",
    "whiteboard",
    "canvas",
    "drawing",
    "infinite-canvas",
    "sketch",
    "react-native-whiteboard",
    "expo",
    "tldraw-alternative",
    "excalidraw-alternative"
  ],
  "dependencies": {
    "@incantly/canvas": "0.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "react-native": "0.76.9"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-native": ">=0.76",
    "react-native-enriched-markdown": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "react-native-enriched-markdown": {
      "optional": true
    }
  },
  "license": "MIT",
  "homepage": "https://github.com/Incantly/canvas",
  "repository": {
    "type": "git",
    "url": "https://github.com/Incantly/canvas.git",
    "directory": "packages/react-native"
  },
  "bugs": "https://github.com/Incantly/canvas/issues",
  "publishConfig": {
    "access": "public"
  }
}
