{
  "name": "@quickdrawjs/react",
  "version": "0.2.0",
  "description": "React component for Quickdraw — the MIT-licensed infinite-canvas whiteboard SDK.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": [
    "react",
    "whiteboard",
    "canvas",
    "drawing",
    "infinite-canvas",
    "react-whiteboard",
    "tldraw-alternative",
    "excalidraw-alternative"
  ],
  "dependencies": {
    "@quickdrawjs/core": "0.2.0"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "license": "MIT",
  "homepage": "https://tryquickdraw.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/quickdrawjs/quickdraw.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/quickdrawjs/quickdraw/issues",
  "publishConfig": {
    "access": "public"
  }
}
