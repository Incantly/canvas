{
  "name": "@incantly/canvas-react",
  "version": "0.2.0",
  "description": "React component for Incantly Canvas — the MIT-licensed infinite-canvas whiteboard SDK.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": [
    "react",
    "whiteboard",
    "canvas",
    "drawing",
    "infinite-canvas",
    "react-whiteboard",
    "tldraw-alternative",
    "excalidraw-alternative"
  ],
  "dependencies": {
    "@incantly/canvas": "0.2.0"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "license": "MIT",
  "homepage": "https://github.com/Incantly/canvas",
  "repository": {
    "type": "git",
    "url": "https://github.com/Incantly/canvas.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/Incantly/canvas/issues",
  "publishConfig": {
    "access": "public"
  }
}
